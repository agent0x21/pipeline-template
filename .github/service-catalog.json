{
  "services": [
    {
      "slug": "dotnet-api",
      "name": "DotnetApi",
      "type": "dotnet",
      "path": "apps/dotnet-api",
      "project": "apps/dotnet-api/DotnetApi.csproj",
      "dockerfile": "apps/dotnet-api/Dockerfile",
      "docker_context": "apps/dotnet-api",
      "dotnet_version": "10.0.x",
      "depends_on": [
        "apps/dotnet-api"
      ]
    },
    {
      "slug": "express",
      "name": "@templates/express",
      "type": "node",
      "path": "apps/express",
      "dockerfile": "apps/express/Dockerfile",
      "docker_context": "apps/express",
      "node_version": "22",
      "install_command": "pnpm install --frozen-lockfile",
      "build_command": "pnpm run build",
      "depends_on": [
        "apps/express"
      ]
    },
    {
      "slug": "next",
      "name": "@templates/next",
      "type": "node",
      "path": "apps/next",
      "dockerfile": "apps/next/Dockerfile",
      "docker_context": "apps/next",
      "node_version": "22",
      "install_command": "pnpm install --frozen-lockfile",
      "build_command": "pnpm run build",
      "depends_on": [
        "apps/next"
      ]
    },
    {
      "slug": "react",
      "name": "@templates/react",
      "type": "node",
      "path": "apps/react",
      "dockerfile": "apps/react/Dockerfile",
      "docker_context": "apps/react",
      "node_version": "22",
      "install_command": "pnpm install --frozen-lockfile",
      "build_command": "pnpm run build",
      "depends_on": [
        "apps/react"
      ]
    }
  ]
}
{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "plugins": [
    "@nx/dotnet"
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.Tests/**/*",
      "!{projectRoot}/**/bin/**/*",
      "!{projectRoot}/**/obj/**/*"
    ]
  },
  "release": {
    "projects": [
      "@templates/express",
      "@templates/next",
      "@templates/react"
    ],
    "projectsRelationship": "independent",
    "version": {
      "conventionalCommits": true,
      "fallbackCurrentVersionResolver": "disk",
      "updateDependents": "always",
      "applyPreidToDependents": true
    },
    "changelog": {
      "projectChangelogs": true,
      "automaticFromRef": true
    },
    "releaseTag": {
      "pattern": "{projectName}@{version}",
      "requireSemver": true,
      "strictPreid": false,
      "checkAllBranchesWhen": false
    }
  }
}
